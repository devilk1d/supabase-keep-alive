# AES-256-GCM encryption key for storing Supabase anon keys in local SQLite (64 hex chars / 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If omitted in local development, a fallback key is auto-generated and stored in .env.local or derived safely;
# set a fixed key here to preserve decryption across restarts or container recreations.
ENCRYPTION_KEY=

# Optional custom path for the local SQLite database file (defaults to ./local.db)
DATABASE_PATH=./local.db

# Optional failure notification webhooks (used by headless runner and local pings)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
